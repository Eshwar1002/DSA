Two zero indexed arrays --> servers and tasks 

servers --> len is n | server[i] is the weight of the i th server 
tasks --> len is m | task[j] is j th task in seconds 


import heapq

class Solution:
    def assignTasks(self, servers: list[int], tasks: list[int]) -> list[int]:

        available = []
        busy = []

        # Add all servers to available heap
        for i, weight in enumerate(servers):
            heapq.heappush(available, (weight, i))

        ans = []
        time = 0

        for j in range(len(tasks)):

            time = max(time, j)

            # Release servers that have completed their tasks
            while busy and busy[0][0] <= time:
                free_time, weight, index = heapq.heappop(busy)
                heapq.heappush(available, (weight, index))

            # If no server is free, wait
            if not available:
                time = busy[0][0]

                while busy and busy[0][0] <= time:
                    free_time, weight, index = heapq.heappop(busy)
                    heapq.heappush(available, (weight, index))

            # Assign the best available server
            weight, index = heapq.heappop(available)

            ans.append(index)

            # Move server to busy heap
            heapq.heappush(busy, (time + tasks[j], weight, index))

        return ans
